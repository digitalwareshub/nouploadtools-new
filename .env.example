# Supabase — get from Supabase project dashboard → Settings → API
# These are public and safe to expose in browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — PRIVATE, server-side only, never prefix with NEXT_PUBLIC_
# Used by private admin and submission routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile
# Public site key used by the browser widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
# PRIVATE secret used only by server-side Siteverify calls.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
# Exact comma-separated hostnames, never derived from client-supplied headers.
# Add localhost only for local testing; add specific preview hosts when needed.
TURNSTILE_ALLOWED_HOSTNAMES=nouploadtools.com,www.nouploadtools.com,nouploadtools-new.vercel.app

# PRIVATE random secret of at least 32 characters for server-side IP HMACs.
# Generate with: openssl rand -hex 32. Missing secret blocks tool submissions.
SUBMISSION_FINGERPRINT_SECRET=

# Admin dashboard password — PRIVATE, server-side only, never prefix with NEXT_PUBLIC_
# Used to protect /admin. Choose a strong password.
ADMIN_PASSWORD=your-strong-admin-password-here

# Upstash Redis — PRIVATE, server-side only, never prefix with NEXT_PUBLIC_
# Get from console.upstash.com. /api/check-tracking retains its optional limiter.
# /api/submit-tool requires these; missing credentials or Redis failure blocks submissions.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# IndexNow — PRIVATE, server-side only, never prefix with NEXT_PUBLIC_
# Used to notify Bing/Yandex/others when new content is published.
# Generate a random key and host it at /{key}.txt in /public.
INDEXNOW_KEY=your-indexnow-key-here
